	"tokenColors": [
		{
			"name": "Global Variables (general)",
			"scope": [
				"variable.global"
			],
			"settings": {
				"foreground": "#FB9711",
				"fontStyle": "italic underline"
			}
		},
		{
			"name": "Parameters (general)",
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#FB971198",
				"fontStyle": "bold italic"
			}
		},
		{
			"name": "Comments (general)",
			"scope": "comment",
			"settings": {
				"foreground": "#794602",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Control keywords (general)",
			"scope": "keyword.control",
			"settings": {
				"foreground": "#FB9711",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Control Directive keywords (general)",
			"scope": "keyword.control.directive",
			"settings": {
				"foreground": "#FB9711",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Operator (general)",
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#FCC479",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Declarations (structs/unions/types) (general)",
			"scope": [
				"keyword.declaration.struct",
				"keyword.declaration.union",
				"keyword.declaration.typedef",
				"keyword.declaration.alias"
			],
			"settings": {
				"foreground": "#FCC479",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Declarations (functions) (general)",
			"scope": [
				"keyword.declaration.function",
				"keyword.declaration.macro"
			],
			"settings": {
				"foreground": "#FBAA3E",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Types (general)",
			"scope": [
				"entity.name.type"
			],
			"settings": {
				"foreground": "#FCC479",
				"fontStyle": ""
			}
		},
		{
			"name": "String (general)",
			"scope": "string.quoted",
			"settings": {
				"foreground": "#FBAA3E",
				"fontStyle": ""
			}
		},
		{
			"name": "Function (general)",
			"scope": [
				"entity.name.function",
				"entity.name.function.member"
			],
			"settings": {
				"foreground": "#FB9711",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Primitive (general)",
			"scope": "storage.type.built-in.primitive",
			"settings": {
				"foreground": "#FCC479",
				"fontStyle": ""
			}
		},
		{
			"name": "Storage modifier (general)",
			"scope": "storage.modifier",
			"settings": {
				"foreground": "#FA950D",
				"fontStyle": "bold italic"
			}
		},
		{
			"name": "Language Constant (general)",
			"scope": "constant.language",
			"settings": {
				"background": "#975702",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Numeric constant (general)",
			"scope": [
				"constant.numeric.binary",
				"constant.numeric.octal",
				"constant.numeric.decimal",
				"constant.numeric.hexadecimal",
				"constant.numeric.integer"
			],
			"settings": {
				"foreground": "#FDDEB4",
				"fontStyle": ""
			}
		},



		{
			"name": "HTML tag",
